APP_NAME="Voice Agent"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Voice AI Agent ---
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model used for the chat brain (e.g. gpt-4o-mini, gpt-4o)
OPENAI_CHAT_MODEL=gpt-4o-mini
# Model used for speech-to-text
OPENAI_STT_MODEL=whisper-1
# Model used for text-to-speech
OPENAI_TTS_MODEL=tts-1
# Voice used for text-to-speech (alloy, echo, fable, onyx, nova, shimmer)
OPENAI_TTS_VOICE=alloy

# VPN client executable path for the open_vpn tool (example: C:\Program Files\NordVPN\NordVPN.exe)
VPN_EXECUTABLE_PATH=

VITE_APP_NAME="${APP_NAME}"
